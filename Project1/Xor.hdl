// File name: projects/1/Xor.hdl
/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */

//Edited by Sylphara

CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    Or(a=a, b=b, out=temp1);
    Nand(a=a, b=b, out=temp2);
    And(a=temp1, b=temp2, out=out);
}