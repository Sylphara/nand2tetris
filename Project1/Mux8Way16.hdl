// File name: projects/1/Mux8Way16.hdl
/**
 * 8-way 16-bit multiplexor:
 * out = a if sel = 000
 *       b if sel = 001
 *       c if sel = 010
 *       d if sel = 011
 *       e if sel = 100
 *       f if sel = 101
 *       g if sel = 110
 *       h if sel = 111
 */

//Edited by Sylphara
 
CHIP Mux8Way16 {
    IN a[16], b[16], c[16], d[16],
       e[16], f[16], g[16], h[16],
       sel[3];
    OUT out[16];

    PARTS:
    Mux16(a=a, b=b, sel=sel[0], out=AandB);
    Mux16(a=c, b=d, sel=sel[0], out=CandD);
    Mux16(a=e, b=f, sel=sel[0], out=EandF);
    Mux16(a=g, b=h, sel=sel[0], out=GandH);
    Mux16(a=AandB, b=CandD, sel=sel[1], out=ABandCD);
    Mux16(a=EandF, b=GandH, sel=sel[1], out=EFandGH);
    Mux16(a=ABandCD, b=EFandGH, sel=sel[2], out=out);
    
}