// File name: projects/2/ALU.hdl
/**
 * ALU (Arithmetic Logic Unit):
 * Computes out = one of the following functions:
 *                0, 1, -1,
 *                x, y, !x, !y, -x, -y,
 *                x + 1, y + 1, x - 1, y - 1,
 *                x + y, x - y, y - x,
 *                x & y, x | y
 * on the 16-bit inputs x, y,
 * according to the input bits zx, nx, zy, ny, f, no.
 * In addition, computes the two output bits:
 * if (out == 0) zr = 1, else zr = 0
 * if (out < 0)  ng = 1, else ng = 0
 */
// Implementation: Manipulates the x and y inputs
// and operates on the resulting values, as follows:
// if (zx == 1) sets x = 0        // 16-bit constant
// if (nx == 1) sets x = !x       // bitwise not
// if (zy == 1) sets y = 0        // 16-bit constant
// if (ny == 1) sets y = !y       // bitwise not
// if (f == 1)  sets out = x + y  // integer 2's complement addition
// if (f == 0)  sets out = x & y  // bitwise and
// if (no == 1) sets out = !out   // bitwise not

//Edited by Sylphara

CHIP ALU {
    IN  
        x[16], y[16],  // 16-bit inputs        
        zx, // zero the x input?
        nx, // negate the x input?
        zy, // zero the y input?
        ny, // negate the y input?
        f,  // compute (out = x + y) or (out = x & y)?
        no; // negate the out output?
    OUT 
        out[16], // 16-bit output
        zr,      // if (out == 0) equals 1, else 0
        ng;      // if (out < 0)  equals 1, else 0

    PARTS:
    Mux16(a=x, b=false, sel=zx, out=checkzx);
    //check for zx = 1, zero if 1

    Not16(in=checkzx, out=checknx);
    Mux16(a=checkzx, b=checknx, sel=nx, out=xpostset);
    //check for nx = 1, negate if 1

    Mux16(a=y, b=false, sel=zy, out=checkzy);
    //check for zy = 1, zero if 1

    Not16(in=checkzy, out=checkny);
    Mux16(a=checkzy, b=checkny, sel=ny, out=ypostset);
    //check for ny = 1, zero if 1

    And16(a=xpostset, b=ypostset, out=xandy);
    Add16(a=xpostset, b=ypostset, out=xplusy);
    Mux16(a=xandy, b=xplusy, sel=f, out=postfcheck);
    //check for x+y or x&y

    Not16(in=postfcheck, out=notf);
    Mux16(a=postfcheck, b=notf, sel=no, out=out, out[0..7]=firstzr, out[8..15]=secondzr, out[15]=ng);
    //check for no, split out for ng and zr (Or8Way, Or16Way does not exist)

    Or8Way(in=firstzr, out=firstor);
    Or8Way(in=secondzr, out=secondor);
    Or(a=firstor, b=secondor, out=zero);
    Not(in=zero, out=zr);
    //check for zr, or both halves and or them together for result

}